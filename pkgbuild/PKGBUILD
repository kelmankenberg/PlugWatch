pkgname=plugwatch
pkgver=0.1.0
pkgrel=1
pkgdesc='Daily updates from the Omarchy plugin marketplace'
arch=('x86_64' 'aarch64')
license=('MIT')
depends=('qt6-base' 'qt6-declarative' 'qt6-wayland')
makedepends=('gcc' 'make')
source=()
sha256sums=()

build() {
  cd "$startdir/.."
  ./bin/build
}

package() {
  cd "$startdir/.."
  install -Dm755 build/plugwatch "$pkgdir/usr/bin/plugwatch"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 "$startdir/plugwatch.svg" "$pkgdir/usr/share/icons/hicolor/scalable/apps/plugwatch.svg"
  install -Dm644 "$startdir/plugwatch.desktop" "$pkgdir/usr/share/applications/plugwatch.desktop"
  install -Dm644 "$startdir/../bar-widget/plugin-manifest.json" "$pkgdir/usr/share/plugwatch/bar-widget/manifest.json"
  install -Dm644 "$startdir/../bar-widget/v3/BarWidget.qml" "$pkgdir/usr/share/plugwatch/bar-widget/v3/BarWidget.qml"
  install -Dm644 "$startdir/../bar-widget/i18n/en.json" "$pkgdir/usr/share/plugwatch/bar-widget/i18n/en.json"
  install -Dm644 "$startdir/../bar-widget/i18n/da.json" "$pkgdir/usr/share/plugwatch/bar-widget/i18n/da.json"
  install -Dm644 "$startdir/../bar-widget/i18n/en.json" "$pkgdir/usr/share/plugwatch/bar-widget/v3/i18n/en.json"
  install -Dm644 "$startdir/../bar-widget/i18n/da.json" "$pkgdir/usr/share/plugwatch/bar-widget/v3/i18n/da.json"
  install -Dm644 "$startdir/plugwatch-check.service" "$pkgdir/usr/lib/systemd/user/plugwatch-check.service"
  install -Dm644 "$startdir/plugwatch-check.timer" "$pkgdir/usr/lib/systemd/user/plugwatch-check.timer"
}
